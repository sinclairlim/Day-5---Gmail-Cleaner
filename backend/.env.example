# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URI=http://localhost:8000/api/auth/callback

# OpenAI API Key (for LangChain)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (Options: gpt-4o-mini, gpt-3.5-turbo, gpt-4)
# gpt-4o-mini: ~$0.001-0.003 per scan (RECOMMENDED - best value)
# gpt-3.5-turbo: ~$0.002-0.005 per scan (good quality, cheaper)
# gpt-4: ~$0.03-0.08 per scan (highest quality, expensive)
OPENAI_MODEL=gpt-4o-mini

# Backend Settings
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
